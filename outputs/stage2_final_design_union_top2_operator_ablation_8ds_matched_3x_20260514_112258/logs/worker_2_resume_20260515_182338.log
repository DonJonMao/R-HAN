              "text_preview": "def is_multiply_prime(a):\n    def is_prime(n):\n        return n > 1 and all(n % i != 0 for i in range(2, int(n**0.5)+1))\n    factors = []\n    temp = a\n    for i in range(2, a+1):\n        if is_prime(i) and temp % i == 0:\n            factors.append(i)\n            temp //= i\n            if len(factors) > 3:...",
