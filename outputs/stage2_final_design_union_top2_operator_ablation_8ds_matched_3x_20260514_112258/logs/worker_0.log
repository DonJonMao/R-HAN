              "text_preview": "def group_element(tuples):\n    grouped = {}\n    for t in tuples:\n        key = t[1]\n        value = t[0]\n        if key in grouped:\n            grouped[key].append(value)\n        else:\n            grouped[key] = [value]\n    return grouped",
