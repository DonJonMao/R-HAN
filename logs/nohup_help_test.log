Stage2-GCR+ sample-parallel runner with MBPP-gated TP4->3x switch

options:
  -h, --help            show this help message and exit
  --data-root DATA_ROOT
  --output-root OUTPUT_ROOT
  --dataset DATASET     Repeatable dataset selection. Default: all datasets
                        under data-root
  --workers WORKERS     Sample shard count / worker count
  --seed SEED
  --mode {auto,tp4,3x}
  --mbpp-progress-path MBPP_PROGRESS_PATH
  --mbpp-dataset MBPP_DATASET
  --mbpp-complete-status MBPP_COMPLETE_STATUS
  --wait-for-mbpp
  --mbpp-poll-interval-s MBPP_POLL_INTERVAL_S
  --mbpp-timeout-s MBPP_TIMEOUT_S
  --tp4-backend TP4_BACKEND
  --x3-backend X3_BACKEND
                        Repeatable backend spec for 3x mode. Format:
                        name=http://host:port@weight
  --router-host ROUTER_HOST
  --router-port ROUTER_PORT
  --router-timeout-s ROUTER_TIMEOUT_S
  --router-health-interval-s ROUTER_HEALTH_INTERVAL_S
  --python-bin PYTHON_BIN
  --train-script TRAIN_SCRIPT
  --train-arg TRAIN_ARG
                        Pass-through args for the train script. Repeatable;
                        each value supports shell-style splitting.
  --cwd CWD
